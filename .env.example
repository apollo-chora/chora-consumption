# Local configuration for chora-consumption.
# Copy to .env and fill in values. Never commit .env or secrets.

CHORA_ENVIRONMENT=dev
PORT=8080
CHORA_GRPC_PORT=9090

# Database (PostgreSQL). CHORA_DB_DSN is the runtime DSN (app_rw role).
POSTGRES_DB=chora_consumption
POSTGRES_USER=chora
POSTGRES_PASSWORD=chora
POSTGRES_PORT=5432
CHORA_DB_DSN=postgres://chora:chora@postgres:5432/chora_consumption?sslmode=disable
CHORA_OUTBOX_DSN=postgres://chora:chora@postgres:5432/chora_consumption?sslmode=disable
CHORA_OUTBOX_WORKER_ID=chora-consumption-local

# Event bus — NATS JetStream. Unset disables the bus (outbox rows accumulate;
# subscribers stay constructed-but-inert).
NATS_URL=nats://nats:4222
NATS_PORT=4222
NATS_MONITOR_PORT=8222

# Project label stamped into every event envelope's source_project.
CHORA_SOURCE_PROJECT=chora-local

# Weakness blob encryption: name of the env var holding the base64-encoded
# AES-256 KEK. Unset → blob encryption disabled (dev only).
WEAKNESS_BLOB_KEK_ENV=
WEAKNESS_UPLOADS_BUCKET=chora-weakness-uploads

# Tracing — OTLP/gRPC endpoint (the OTel Collector). Unset falls back to stdout.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
